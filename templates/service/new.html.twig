{% extends 'base.html.twig' %}

{% block title %}Naujas servisas{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block body %}
    <section class="page-section pt-0">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div
                        class="card-body p-4 p-lg-5"
                        data-service-form
                        data-categories-id="{{ form.categories.vars.id }}"
                    >
                        <div class="page-header">
                            <h1 class="section-title">Naujas servisas</h1>
                            <p class="section-subtitle">
                                Užpildykite pagrindinę serviso informaciją, pasirinkite darbo dienas ir laiką, įkelkite nuotrauką ir priskirkite tinkamas kategorijas.
                            </p>
                        </div>

                        {{ form_start(form) }}

                            <div class="mb-3">
                                {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Įveskite serviso pavadinimą'}}) }}
                                {{ form_errors(form.name) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.address, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.address, {'attr': {'class': 'form-control', 'placeholder': 'Įveskite serviso adresą'}}) }}
                                {{ form_errors(form.address) }}
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Pvz. +37060000000'}}) }}
                                    {{ form_errors(form.phone) }}
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Pvz. info@servisas.lt'}}) }}
                                    {{ form_errors(form.email) }}
                                </div>
                            </div>

                            <div class="service-form-section">
                                <h5 class="form-section-title">Darbo grafikas</h5>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workDayFrom, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workDayFrom, {'attr': {'class': 'form-select'}}) }}
                                        {{ form_errors(form.workDayFrom) }}
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workDayTo, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workDayTo, {'attr': {'class': 'form-select'}}) }}
                                        {{ form_errors(form.workDayTo) }}
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workTimeFrom, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workTimeFrom, {'attr': {'class': 'form-control js-timepicker', 'autocomplete': 'off', 'placeholder': 'Pasirinkite laiką'}}) }}
                                        {{ form_errors(form.workTimeFrom) }}
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workTimeTo, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workTimeTo, {'attr': {'class': 'form-control js-timepicker', 'autocomplete': 'off', 'placeholder': 'Pasirinkite laiką'}}) }}
                                        {{ form_errors(form.workTimeTo) }}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Trumpai aprašykite servisą'}}) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.imageFile) }}
                                <div class="form-text">
                                    Galite įkelti JPG, PNG arba WEBP nuotrauką.
                                </div>
                            </div>

                            <div class="mb-4">
                                {{ form_label(form.categories, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.categories, {'attr': {'class': 'form-select tom-select', 'multiple': 'multiple'}}) }}
                                {{ form_errors(form.categories) }}
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="submit" class="btn btn-primary">Išsaugoti</button>
                                <a href="/services" class="btn btn-secondary">Grįžti</a>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/lt.js"></script>
    <script src="{{ asset('js/service-form.js') }}"></script>
{% endblock %}