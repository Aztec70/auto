{% extends 'base.html.twig' %}

{% block title %}Redaguoti servisą{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block body %}
    <section class="page-section pt-0">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card">
                    <div
                        class="card-body p-4 p-lg-5"
                        data-service-form
                        data-categories-id="{{ form.categories.vars.id }}"
                    >
                        <div class="page-header">
                            <h1 class="section-title">Redaguoti servisą</h1>
                            <p class="section-subtitle">
                                Atnaujinkite serviso duomenis, kontaktinę informaciją, darbo grafiką, nuotrauką ir kategorijas.
                            </p>
                        </div>

                        {% if service.imageName %}
                            <div class="mb-4">
                                <label class="form-label">Dabartinė nuotrauka</label>
                                <div class="image-preview-box">
                                    <img
                                        src="{{ asset('uploads/services/' ~ service.imageName) }}"
                                        alt="{{ service.name }}"
                                        class="img-fluid w-100"
                                    >
                                </div>
                            </div>
                        {% endif %}

                        {{ form_start(form, {
                            attr: {
                                class: 'needs-validation',
                                novalidate: 'novalidate'
                            }
                        }) }}

                            <div class="mb-3">
                                {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.name, {
                                    attr: {
                                        class: 'form-control',
                                        required: 'required',
                                        minlength: 3,
                                        maxlength: 100,
                                        pattern: '[A-Za-zĄČĘĖĮŠŲŪŽąčęėįšųūž0-9\\s\\-\\.,&]+',
                                        placeholder: 'Įveskite serviso pavadinimą'
                                    }
                                }) }}
                                <div class="invalid-feedback">
                                    Įveskite tinkamą serviso pavadinimą. Pavadinimas turi būti nuo 3 iki 100 simbolių.
                                </div>
                                {% if form.name.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.name.vars.errors %}
                                            <div>{{ error.message }}</div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.address, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.address, {
                                    attr: {
                                        class: 'form-control',
                                        required: 'required',
                                        minlength: 5,
                                        maxlength: 150,
                                        placeholder: 'Įveskite serviso adresą'
                                    }
                                }) }}
                                <div class="invalid-feedback">
                                    Įveskite serviso adresą. Adresas turi būti nuo 5 iki 150 simbolių.
                                </div>
                                {% if form.address.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.address.vars.errors %}
                                            <div>{{ error.message }}</div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.phone, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.phone, {
                                        attr: {
                                            class: 'form-control',
                                            required: 'required',
                                            minlength: 9,
                                            maxlength: 12,
                                            pattern: '(\\+3706\\d{7}|06\\d{7})',
                                            placeholder: 'Pvz. +37060000000 arba 060000000'
                                        }
                                    }) }}
                                    <div class="invalid-feedback">
                                        Įveskite lietuvišką telefono numerį formatu +3706xxxxxxx arba 06xxxxxxx.
                                    </div>
                                    {% if form.phone.vars.errors|length > 0 %}
                                        <div class="invalid-feedback d-block">
                                            {% for error in form.phone.vars.errors %}
                                                <div>{{ error.message }}</div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.email, {
                                        attr: {
                                            class: 'form-control',
                                            required: 'required',
                                            maxlength: 180,
                                            placeholder: 'Pvz. info@servisas.lt'
                                        }
                                    }) }}
                                    <div class="invalid-feedback">
                                        Įveskite tinkamą el. pašto adresą.
                                    </div>
                                    {% if form.email.vars.errors|length > 0 %}
                                        <div class="invalid-feedback d-block">
                                            {% for error in form.email.vars.errors %}
                                                <div>{{ error.message }}</div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="service-form-section">
                                <h5 class="form-section-title">Darbo grafikas</h5>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workDayFrom, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workDayFrom, {
                                            attr: {
                                                class: 'form-select',
                                                required: 'required'
                                            }
                                        }) }}
                                        <div class="invalid-feedback">
                                            Pasirinkite darbo pradžios dieną.
                                        </div>
                                        {{ form_errors(form.workDayFrom) }}
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workDayTo, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workDayTo, {
                                            attr: {
                                                class: 'form-select',
                                                required: 'required'
                                            }
                                        }) }}
                                        <div class="invalid-feedback">
                                            Pasirinkite darbo pabaigos dieną.
                                        </div>
                                        {{ form_errors(form.workDayTo) }}
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workTimeFrom, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workTimeFrom, {
                                            attr: {
                                                class: 'form-control js-timepicker',
                                                autocomplete: 'off',
                                                required: 'required',
                                                placeholder: 'Pasirinkite laiką'
                                            }
                                        }) }}
                                        <div class="invalid-feedback">
                                            Pasirinkite darbo pradžios laiką.
                                        </div>
                                        {{ form_errors(form.workTimeFrom) }}
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        {{ form_label(form.workTimeTo, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(form.workTimeTo, {
                                            attr: {
                                                class: 'form-control js-timepicker',
                                                autocomplete: 'off',
                                                required: 'required',
                                                placeholder: 'Pasirinkite laiką'
                                            }
                                        }) }}
                                        <div class="invalid-feedback">
                                            Pasirinkite darbo pabaigos laiką.
                                        </div>
                                        {{ form_errors(form.workTimeTo) }}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.description, {
                                    attr: {
                                        class: 'form-control',
                                        rows: 4,
                                        maxlength: 1000,
                                        placeholder: 'Trumpai aprašykite servisą',
                                        'data-character-counter': 'service-description-counter'
                                    }
                                }) }}
                                <div id="service-description-counter" class="form-text text-end">0 / 1000</div>
                                <div class="invalid-feedback">
                                    Aprašymas negali būti ilgesnis nei 1000 simbolių.
                                </div>
                                {% if form.description.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.description.vars.errors %}
                                            <div>{{ error.message }}</div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.imageFile, {
                                    attr: {
                                        class: 'form-control',
                                        accept: 'image/jpeg,image/png,image/webp'
                                    }
                                }) }}
                                <div class="invalid-feedback">
                                    Įkelkite JPG, PNG arba WEBP formato nuotrauką.
                                </div>
                                {% if form.imageFile.vars.errors|length > 0 %}
                                    <div class="invalid-feedback d-block">
                                        {% for error in form.imageFile.vars.errors %}
                                            <div>{{ error.message }}</div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                <div class="form-text">
                                    Jei pasirinksite naują nuotrauką, sena bus pakeista. Galimi formatai: JPG, PNG arba WEBP. Maksimalus dydis – 4 MB.
                                </div>
                            </div>

                            <div class="mb-4">
                                {{ form_label(form.categories, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.categories, {
                                    attr: {
                                        class: 'form-select tom-select',
                                        multiple: 'multiple',
                                        required: 'required'
                                    }
                                }) }}
                                <div class="invalid-feedback">
                                    Pasirinkite bent vieną kategoriją.
                                </div>
                                {{ form_errors(form.categories) }}
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="submit" class="btn btn-primary">Atnaujinti</button>
                                <a href="/services" class="btn btn-secondary">Grįžti</a>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/lt.js"></script>
    <script src="{{ asset('js/service-form.js') }}"></script>
{% endblock %}