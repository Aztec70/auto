{% extends 'base.html.twig' %}

{% block title %}Prisijungimas{% endblock %}

{% block body %}
    <section class="page-section auth-section">
        <div class="container">
            <div class="auth-card">
                <div class="card">
                    <div class="card-body p-4 p-lg-5">
                        <div class="text-center mb-4">
                            <div class="feature-icon mx-auto">
                                <i class="bi bi-box-arrow-in-right"></i>
                            </div>
                            <h1 class="auth-title mb-2">Prisijungimas</h1>
                            <p class="auth-subtitle">Prisijunkite prie autoservisai sistemos</p>
                        </div>

                        {% if error %}
                            <div class="alert alert-danger">
                                Neteisingi prisijungimo duomenys.
                            </div>
                        {% endif %}

                        {% if app.user %}
                            <div class="alert alert-info">
                                Jūs prisijungęs kaip {{ app.user.userIdentifier }},
                                <a href="{{ path('app_logout') }}">Atsijungti</a>
                            </div>
                        {% endif %}

                        <form method="post" class="needs-validation" novalidate>
                            <div class="mb-3">
                                <label for="inputEmail" class="form-label">El. paštas</label>
                                <input type="email"
                                       value="{{ last_username }}"
                                       name="email"
                                       id="inputEmail"
                                       class="form-control"
                                       autocomplete="email"
                                       required
                                       autofocus
                                       placeholder="Įveskite savo el. paštą">

                                <div class="invalid-feedback">
                                    El. pašto formatas nėra tinkamas.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="inputPassword" class="form-label">Slaptažodis</label>
                                <input type="password"
                                       name="password"
                                       id="inputPassword"
                                       class="form-control"
                                       autocomplete="current-password"
                                       required
                                       placeholder="Įveskite slaptažodį">

                                <div class="invalid-feedback">
                                    Įveskite slaptažodį.
                                </div>
                            </div>

                            <div class="form-check mb-4 show-password-check">
                                <input
                                    type="checkbox"
                                    class="form-check-input"
                                    id="showPassword"
                                    data-password-toggle="inputPassword"
                                >
                                <label class="form-check-label" for="showPassword">Rodyti slaptažodį</label>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <button class="btn btn-primary w-100 mb-3" type="submit">
                                Prisijungti
                            </button>

                            <div class="text-center footer-note">
                                Neturite paskyros?
                                <a href="/register" class="fw-semibold">Registruokitės</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/auth.js') }}"></script>
{% endblock %}