{% extends 'base.html.twig' %}

{% block title %}Slaptažodžio keitimas{% endblock %}

{% block body %}
    <section class="page-section auth-section">
        <div class="container">
            <div class="auth-card">
                <div class="card">
                    <div class="card-body p-4 p-lg-5">
                        <div class="text-center mb-4">
                            <div class="feature-icon mx-auto">
                                <i class="bi bi-shield-lock"></i>
                            </div>
                            <h1 class="auth-title mb-2">Slaptažodžio keitimas</h1>
                            <p class="auth-subtitle">Atnaujinkite savo paskyros slaptažodį</p>
                        </div>

                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.currentPassword) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.newPassword.first, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.newPassword.first) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.newPassword.second) }}
                                {{ form_errors(form.newPassword) }}
                            </div>

                            <div class="form-check mb-4">
                                <input
                                    type="checkbox"
                                    class="form-check-input"
                                    id="showPasswordChange"
                                    data-password-toggle="{{ form.newPassword.first.vars.id }},{{ form.newPassword.second.vars.id }}"
                                >
                                <label class="form-check-label" for="showPasswordChange">Rodyti naują slaptažodį</label>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="submit" class="btn btn-primary w-100">Pakeisti slaptažodį</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/auth.js') }}"></script>
{% endblock %}