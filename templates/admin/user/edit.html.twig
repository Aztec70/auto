{% extends 'base.html.twig' %}

{% block title %}Redaguoti vartotoją{% endblock %}

{% block body %}
    <section class="page-section pt-0">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div
                    class="card"
                    data-admin-user-form
                    data-role-id="{{ form.roles.vars.id }}"
                    data-service-id="{{ form.service.vars.id }}"
                    data-service-wrapper-id="service-field-wrapper"
                >
                    <div class="card-body p-4 p-lg-5">
                        <div class="page-header">
                            <h1 class="section-title">Redaguoti vartotoją</h1>
                            <p class="section-subtitle">
                                Atnaujinkite vartotojo el. paštą, rolę ir priskirtą servisą.
                            </p>
                        </div>

                        <div class="vehicle-info-card">
                            <h5 class="form-section-title">Esama informacija</h5>
                            <p class="mb-2"><strong>ID:</strong> {{ editedUser.id }}</p>
                            <p class="mb-0"><strong>Dabartinis el. paštas:</strong> {{ editedUser.email }}</p>
                        </div>

                        {{ form_start(form) }}

                            <div class="mb-3">
                                {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Įveskite el. paštą'}}) }}
                                {{ form_errors(form.email) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.roles) }}
                            </div>

                            <div class="mb-4" id="service-field-wrapper">
                                {{ form_label(form.service, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.service, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.service) }}
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="submit" class="btn btn-primary">Išsaugoti pakeitimus</button>
                                <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">Grįžti</a>
                            </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/admin-user-form.js') }}"></script>
{% endblock %}