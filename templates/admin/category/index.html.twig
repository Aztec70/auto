{% extends 'base.html.twig' %}

{% block title %}Kategorijų valdymas{% endblock %}

{% block body %}
    <section class="page-section pt-0">
        <div class="page-header d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <h1 class="section-title">Kategorijų valdymas</h1>
                <p class="section-subtitle">
                    Čia galite pridėti, redaguoti arba ištrinti serviso kategorijas.
                </p>
            </div>

            <a href="{{ path('app_admin_category_new') }}" class="btn btn-primary">
                Pridėti kategoriją
            </a>
        </div>

        {% if categories is empty %}
            <div class="card empty-state">
                <div class="card-body">
                    <div class="empty-state-icon">
                        <i class="bi bi-tags"></i>
                    </div>

                    <h5 class="fw-bold mb-2">Kategorijų nėra</h5>

                    <p class="text-soft mb-3">
                        Dar nėra sukurtų serviso kategorijų.
                    </p>

                    <a href="{{ path('app_admin_category_new') }}" class="btn btn-primary">
                        Sukurti pirmą kategoriją
                    </a>
                </div>
            </div>
        {% else %}
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Pavadinimas</th>
                                    <th>Priskirtų servisų kiekis</th>
                                    <th>Veiksmai</th>
                                </tr>
                            </thead>

                            <tbody>
                                {% for category in categories %}
                                    <tr>
                                        <td class="fw-semibold">
                                            {{ category.name }}
                                        </td>

                                        <td>
                                            {{ category.services|length }}
                                        </td>

                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a href="{{ path('app_admin_category_edit', {id: category.id}) }}"
                                                   class="btn btn-sm btn-primary">
                                                    Redaguoti
                                                </a>

                                                {% if category.services|length > 0 %}
                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-danger disabled"
                                                        data-bs-toggle="tooltip"
                                                        data-bs-placement="top"
                                                        title="Kategorija naudojama servisuose, todėl jos ištrinti negalima."
                                                    >
                                                        Ištrinti
                                                    </button>
                                                {% else %}
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteCategoryModal{{ category.id }}">
                                                        Ištrinti
                                                    </button>
                                                {% endif %}
                                            </div>

                                            {% if category.services|length == 0 %}
                                                <div class="modal fade" id="deleteCategoryModal{{ category.id }}" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <form method="post" action="{{ path('app_admin_category_delete', {id: category.id}) }}">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">Ištrinti kategoriją</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uždaryti"></button>
                                                                </div>

                                                                <div class="modal-body">
                                                                    <p class="mb-3">
                                                                        Ar tikrai norite ištrinti šią kategoriją?
                                                                    </p>

                                                                    <div class="modal-summary-card small">
                                                                        <div><strong>Kategorija:</strong> {{ category.name }}</div>
                                                                        <div><strong>Priskirtų servisų kiekis:</strong> {{ category.services|length }}</div>
                                                                    </div>
                                                                </div>

                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                        Atšaukti
                                                                    </button>

                                                                    <button type="submit" class="btn btn-danger">
                                                                        Taip, ištrinti
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}