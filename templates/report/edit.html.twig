{% extends 'base.html.twig' %}

{% block title %}Redaguoti ataskaitą{% endblock %}

{% block body %}
    <section class="page-section pt-0">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card">
                    <div class="card-body p-4 p-lg-5">
                        <div class="page-header">
                            <h1 class="section-title">Redaguoti remonto ataskaitą</h1>
                            <p class="section-subtitle">
                                Atnaujinkite remonto informaciją, atliktus darbus ir kainą.
                            </p>
                        </div>

                        <div class="vehicle-info-card">
                            <h5 class="form-section-title">Registracijos informacija</h5>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="details-card h-100">
                                        <p class="mb-2"><strong>Klientas:</strong> {{ appointment.user.email }}</p>
                                        <p class="mb-2"><strong>Servisas:</strong> {{ appointment.service.name }}</p>
                                        <p class="mb-0"><strong>Automobilis:</strong> {{ appointment.carBrand }} {{ appointment.carModel }} ({{ appointment.carYear }})</p>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="details-card h-100">
                                        <p class="mb-2"><strong>Vizito data:</strong> {{ appointment.visitDate|date('Y-m-d H:i') }}</p>
                                        <p class="mb-0"><strong>Problemos aprašymas:</strong> {{ appointment.problemDescription }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {{ form_start(form) }}
                            <div class="mb-3">
                                {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Įrašykite bendrą remonto aprašymą'}}) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.workPerformed, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.workPerformed, {'attr': {'class': 'form-control', 'rows': 6, 'placeholder': 'Įrašykite, kokie darbai buvo atlikti'}}) }}
                                {{ form_errors(form.workPerformed) }}
                            </div>

                            <div class="mb-4 field-width-sm">
                                {{ form_label(form.price, null, {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.price) }}
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button type="submit" class="btn btn-primary">Išsaugoti pakeitimus</button>
                                <a href="{{ path('app_employee_report_show', {'id': appointment.id}) }}" class="btn btn-secondary">Atgal į peržiūrą</a>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}