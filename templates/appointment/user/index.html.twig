{% extends 'base.html.twig' %}

{% block title %}Mano registracijos{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block body %}
    <section class="page-section pt-0">
        <div class="page-header">
            <h1 class="section-title">Mano registracijos</h1>
            <p class="section-subtitle">
                Čia galite peržiūrėti savo registracijas, stebėti jų būseną, redaguoti laukiančias registracijas ir atidaryti remonto ataskaitas.
            </p>
        </div>

        {% if appointments is empty %}
            <div class="card empty-state">
                <div class="card-body">
                    <div class="empty-state-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Registracijų dar nėra</h5>
                    <p class="text-soft mb-3">Kol kas neturite nei vienos registracijos autoservise.</p>
                    <a href="{{ path('app_appointment_new') }}" class="btn btn-primary">
                        Sukurti registraciją
                    </a>
                </div>
            </div>
        {% else %}
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 appointment-table">
                            <thead class="table-dark">
                                <tr>
                                    <th>Servisas</th>
                                    <th>Automobilis</th>
                                    <th>Vizito data</th>
                                    <th>Problema</th>
                                    <th>Statusas</th>
                                    <th>Sukurta</th>
                                    <th>Veiksmai</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for appointment in appointments %}
                                    <tr>
                                        <td>{{ appointment.service.name }}</td>

                                        <td>
                                            <div class="appointment-car">
                                                {{ appointment.carBrand }} {{ appointment.carModel }} ({{ appointment.carYear }})
                                            </div>
                                        </td>

                                        <td>
                                            <div class="appointment-datetime">
                                                {{ appointment.visitDate|date('Y-m-d H:i') }}
                                            </div>
                                        </td>

                                        <td>
                                            <div class="appointment-problem">
                                                {{ appointment.problemDescription }}
                                            </div>
                                        </td>

                                        <td>
                                            <div class="mb-2">
                                                {% if appointment.status == 'Laukia' %}
                                                    <span class="status-badge status-waiting">{{ appointment.status }}</span>
                                                {% elseif appointment.status == 'Reikia patikslinimo' %}
                                                    <span class="status-badge status-clarify">{{ appointment.status }}</span>
                                                {% elseif appointment.status == 'Patvirtinta' %}
                                                    <span class="status-badge status-confirmed">{{ appointment.status }}</span>
                                                {% elseif appointment.status == 'Baigta' %}
                                                    <span class="status-badge status-done">{{ appointment.status }}</span>
                                                {% elseif appointment.status == 'Atšaukta' %}
                                                    <span class="status-badge bg-danger text-white">{{ appointment.status }}</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">{{ appointment.status }}</span>
                                                {% endif %}
                                            </div>

                                            {% if appointment.status == 'Reikia patikslinimo' %}
                                                <div class="alert alert-warning appointment-note mt-2 mb-0 p-2 small">
                                                    <strong>Servisas prašo patikslinti:</strong><br>

                                                    {% if appointment.needsDescriptionClarification %}
                                                        <div>Problemos aprašymą.</div>
                                                    {% endif %}

                                                    {% if appointment.needsTimeClarification %}
                                                        <div>Vizito laiką.</div>
                                                    {% endif %}

                                                </div>
                                            {% elseif appointment.employeeNote %}
                                                <div class="alert alert-warning appointment-note mt-2 mb-0 p-2 small">
                                                    <strong>Serviso pastaba:</strong><br>
                                                    {{ appointment.employeeNote }}
                                                </div>
                                            {% endif %}

                                            {% if appointment.cancelReason %}
                                                <div class="alert alert-danger appointment-note mt-2 mb-0 p-2 small">
                                                    <strong>Atšaukimo priežastis:</strong><br>
                                                    {{ appointment.cancelReason }}
                                                </div>
                                            {% endif %}

                                            {% if appointment.report is not null %}
                                                <div class="mt-2">
                                                    <a href="{{ path('app_user_report_show', {'id': appointment.id}) }}" class="btn btn-sm btn-outline-primary">
                                                        Peržiūrėti ataskaitą
                                                    </a>
                                                </div>
                                            {% endif %}
                                        </td>

                                        <td>{{ appointment.createdAt|date('Y-m-d H:i') }}</td>

                                        <td class="appointment-actions">
                                            {% if appointment.status == 'Laukia' %}
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a href="{{ path('app_appointment_edit', {id: appointment.id}) }}" class="btn btn-sm btn-warning">
                                                        Redaguoti
                                                    </a>

                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteModal{{ appointment.id }}"
                                                    >
                                                        Atšaukti
                                                    </button>
                                                </div>

                                                <div class="modal fade" id="deleteModal{{ appointment.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ appointment.id }}" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h5 class="modal-title" id="deleteModalLabel{{ appointment.id }}">Registracijos atšaukimas</h5>
                                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uždaryti"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                Ar tikrai norite atšaukti šią registraciją?

                                                                <div class="mt-3 small text-muted">
                                                                    <div><strong>Servisas:</strong> {{ appointment.service.name }}</div>
                                                                    <div><strong>Automobilis:</strong> {{ appointment.carBrand }} {{ appointment.carModel }} ({{ appointment.carYear }})</div>
                                                                    <div><strong>Vizito data:</strong> {{ appointment.visitDate|date('Y-m-d H:i') }}</div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                    Ne
                                                                </button>
                                                                <a href="{{ path('app_appointment_delete', {id: appointment.id}) }}" class="btn btn-danger">
                                                                    Taip, atšaukti
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% elseif appointment.status == 'Reikia patikslinimo' %}
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button type="button"
                                                            class="btn btn-sm btn-warning"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#clarifyModal{{ appointment.id }}">
                                                        Patikslinti
                                                    </button>
                                                </div>

                                                <div class="modal fade" id="clarifyModal{{ appointment.id }}" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content">
                                                            <form method="post" action="{{ path('app_appointment_clarify', {id: appointment.id}) }}">
                                                                <div class="modal-header">
                                                                    <h5 class="modal-title">Patikslinti registraciją</h5>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Uždaryti"></button>
                                                                </div>

                                                                <div class="modal-body">
                                                                    <div class="modal-summary-card mb-3 small">
                                                                        <div><strong>Servisas:</strong> {{ appointment.service.name }}</div>
                                                                        <div><strong>Automobilis:</strong> {{ appointment.carBrand }} {{ appointment.carModel }} ({{ appointment.carYear }})</div>
                                                                        <div><strong>Dabartinis vizito laikas:</strong> {{ appointment.visitDate|date('Y-m-d H:i') }}</div>
                                                                    </div>

                                                                    {% if appointment.employeeNote %}
                                                                        <div class="alert alert-warning small">
                                                                            <strong>Serviso pastaba:</strong><br>
                                                                            {{ appointment.employeeNote }}
                                                                        </div>
                                                                    {% endif %}

                                                                    {% if appointment.needsDescriptionClarification %}
                                                                        <div class="mb-3">
                                                                            <label class="form-label">Patikslintas problemos aprašymas</label>
                                                                            <textarea name="problemDescription"
                                                                                      class="form-control"
                                                                                      rows="5"
                                                                                      required>{{ appointment.problemDescription }}</textarea>
                                                                        </div>
                                                                    {% endif %}

                                                                    {% if appointment.needsTimeClarification %}
                                                                        <div class="mb-3">
                                                                            <label class="form-label">Naujas vizito laikas</label>
                                                                            <input type="text"
                                                                                   name="visitDate"
                                                                                   class="form-control user-clarification-flatpickr"
                                                                                   data-service-id="{{ appointment.service.id }}"
                                                                                   data-exclude-id="{{ appointment.id }}"
                                                                                   data-busy-url="{{ path('app_appointment_busy_slots', {'serviceId': appointment.service.id, 'excludeId': appointment.id}) }}"
                                                                                   data-work-time-from="{{ appointment.service.workTimeFrom ? appointment.service.workTimeFrom|date('H:i') : '08:00' }}"
                                                                                   data-work-time-to="{{ appointment.service.workTimeTo ? appointment.service.workTimeTo|date('H:i') : '17:00' }}"
                                                                                   data-work-day-from="{{ appointment.service.workDayFrom ?? 1 }}"
                                                                                   data-work-day-to="{{ appointment.service.workDayTo ?? 5 }}"
                                                                                   value="{{ appointment.visitDate|date('Y-m-d H:i') }}"
                                                                                   placeholder="Pasirinkite naują laiką"
                                                                                   required>
                                                                        </div>
                                                                    {% endif %}

                                                                    <div class="form-text">
                                                                        Išsaugojus, lentelėje bus atnaujinti pakeisti registracijos duomenys.
                                                                    </div>
                                                                </div>

                                                                <div class="modal-footer">
                                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                                        Uždaryti
                                                                    </button>
                                                                    <button type="submit" class="btn btn-warning">
                                                                        Išsaugoti patikslinimą
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="{{ asset('js/appointment-clarification.js') }}"></script>
{% endblock %}